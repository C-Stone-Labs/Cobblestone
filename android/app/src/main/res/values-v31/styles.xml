<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ sistem splash'ı: simgeyi GÖSTERME (şeffaf), sadece
         koyu zemin ver. Böylece açılışta önce statik logo parlaması olmaz;
         animasyon Cobblestone'un kendi splash ekranında oynar. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">#0D0D0D</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimationDuration">200</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>

